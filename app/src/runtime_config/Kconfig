menuconfig ZMK_RUNTIME_CONFIG
    bool "ZMK Next runtime configuration"
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Enable bounded ZMK Next runtime configuration: the snapshot model,
      Studio RPC service, transactional Settings storage, and safe activation
      coordinator. It overlays compiled behavior bindings or runtime objects
      when an active runtime snapshot supplies an override; later phases add
      further advanced behavior engines.

if ZMK_RUNTIME_CONFIG

config ZMK_RUNTIME_MAX_OBJECTS
    int "Maximum runtime objects"
    range 1 255
    default 64
    help
      Fixed capacity for user-defined runtime behavior objects.

config ZMK_RUNTIME_MAX_COMBOS
    int "Maximum runtime combos"
    range 1 255
    default 32
    help
      Fixed capacity for runtime combo definitions.

config ZMK_RUNTIME_MAX_COMBO_KEYS
    int "Maximum keys in one runtime combo"
    range 1 16
    default 5
    help
      Maximum number of logical key positions allowed in one runtime combo.

config ZMK_RUNTIME_MAX_MACRO_STEPS
    int "Maximum runtime macro steps"
    range 1 4096
    default 512
    help
      Fixed capacity for macro instructions across a runtime configuration.

config ZMK_RUNTIME_MAX_PERSISTED_BYTES
    int "Maximum runtime configuration persistence size"
    range 256 65535
    default 4096
    help
      Maximum serialized runtime configuration size. The on-flash format is
      private to the firmware and stored transactionally when persistence is
      enabled.

config ZMK_RUNTIME_MAX_KEYMAP_OVERRIDES
    int "Maximum runtime keymap overrides"
    range 1 4096
    default 256
    help
      Fixed capacity for user-defined bindings that override the compiled
      keymap. Positions are in stock logical-keymap space, independent of the
      selected physical layout.

config ZMK_RUNTIME_CONFIG_RPC
    bool "Expose runtime configuration through Studio RPC"
    depends on ZMK_STUDIO_RPC
    default y
    help
      Expose the ZMK Next Runtime Config subsystem through the existing Studio
      USB serial and BLE transports.

config ZMK_RUNTIME_CONFIG_RPC_MAX_CHUNK_BYTES
    int "Maximum Runtime Config RPC chunk size"
    range 16 1024
    default 128
    help
      Largest RuntimeConfigSnapshot upload chunk accepted by firmware. This
      bounds RAM required for each decoded RPC request; complete snapshots are
      assembled in the fixed serialized-snapshot buffer.

config ZMK_RUNTIME_CONFIG_PERSISTENCE
    bool "Persist Runtime Config snapshots with Zephyr Settings"
    depends on SETTINGS
    default y
    help
      Store validated Runtime Config snapshots in two alternating Settings
      slots. A manifest is written last so an interrupted update leaves the
      prior complete slot recoverable.

config ZMK_RUNTIME_CONFIG_ACTIVATION_IDLE_MS
    int "Runtime Config safe activation idle time (ms)"
    range 1 1000
    default 25
    help
      Require this much continuous keyboard-idle time before a persisted
      Runtime Config generation becomes active. Physical key presses and
      runtime behavior-engine blockers keep the generation pending.

if ZMK_RUNTIME_CONFIG_PERSISTENCE

config ZMK_RUNTIME_CONFIG_SETTINGS_CHUNK_BYTES
    int "Runtime Config Settings payload chunk size"
    range 64 1024
    default 256
    help
      Maximum bytes stored in one Zephyr Settings key. This bounds Settings
      write size while the complete snapshot remains bounded by
      CONFIG_ZMK_RUNTIME_MAX_PERSISTED_BYTES.

endif

endif
