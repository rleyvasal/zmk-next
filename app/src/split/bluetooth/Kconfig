if ZMK_SPLIT && ZMK_SPLIT_BLE

menu "BLE Transport"

config ZMK_SPLIT_BLE_PRIORITY
    int "BLE transport priority"
    help
        Lower number priorities transports are favored over higher numbers.

# Added for backwards compatibility. New shields / board should set `ZMK_SPLIT_ROLE_CENTRAL` only.
config ZMK_SPLIT_BLE_ROLE_CENTRAL
    bool
    select ZMK_SPLIT_ROLE_CENTRAL

config ZMK_SPLIT_ROLE_CENTRAL
    select BT_CENTRAL
    select BT_GATT_CLIENT
    select BT_GATT_AUTO_DISCOVER_CCC
    select BT_SCAN_WITH_IDENTITY

# Bump this value needed for concurrent GATT discovery of splits
config BT_ATT_TX_COUNT
    default 10 if ZMK_SPLIT_ROLE_CENTRAL

if ZMK_SPLIT_ROLE_CENTRAL

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    int "Number of peripherals that will connect to the central."

menuconfig ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    bool "Fetch Peripheral Battery Level Info"
    help
      Adds internal support for fetching the battery levels from peripherals
      and generating events in the ZMK eventing system.

if ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_QUEUE_SIZE
    int "Max number of battery level events to queue when received from peripherals"
    default ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    bool "Proxy Peripheral Battery Level Info"
    help
      Adds support for reporting the battery levels of connected split
      peripherals through an additional Battery Level service.

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY_SWAP
    bool "Report the peripheral in the primary Battery Service"
    depends on ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    depends on ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS = 1
    help
      Swap the two Battery Services for a two-half keyboard: the primary BAS
      reports the peripheral, and the additional one reports this central
      half, labeled "Left" with the "main" description. Host battery apps that
      read the primary BAS as the right half and the second one as the left
      half (Mighty Mitts on macOS) then show both halves. Notifications for
      each half are rate-limited to one per second. With
      CONFIG_ZMK_BATTERY_CHARGE_STATUS, the primary BAS's Battery Level Status
      carries the peripheral's charge state.

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_RETAIN
    bool "Keep a peripheral's last battery level while it is disconnected"
    help
      By default a disconnected peripheral's level drops to 0. With this
      option the last level read from it is kept, for Studio and for the
      proxy, until a read after reconnecting replaces it.

endif

config ZMK_SPLIT_BLE_CENTRAL_POSITION_QUEUE_SIZE
    int "Max number of key position state events to queue when received from peripherals"
    default 5

config ZMK_SPLIT_BLE_CENTRAL_SPLIT_RUN_STACK_SIZE
    int "BLE split central write thread stack size"
    default 512

config ZMK_SPLIT_BLE_CENTRAL_SPLIT_RUN_QUEUE_SIZE
    int "Max number of behavior run events to queue to send to the peripheral(s)"
    default 5

config ZMK_SPLIT_BLE_PREF_INT
    int "Connection interval to use for split central/peripheral connection"
    default 6

config ZMK_SPLIT_BLE_PREF_LATENCY
    int "Latency to use for split central/peripheral connection"
    default 30

config ZMK_SPLIT_BLE_PREF_TIMEOUT
    int "Supervision timeout to use for split central/peripheral connection"
    default 400

config ZMK_SPLIT_BLE_IDLE_INT
    int "Connection interval for the split connection while the keyboard is idle"
    default 0
    help
      Interval (in 1.25 ms units) to switch the split connections to when the
      keyboard goes idle (CONFIG_ZMK_IDLE_TIMEOUT). The central sends on every
      connection event, so a slower interval while nothing is typed saves most
      of its split radio power. The first key press switches back to
      CONFIG_ZMK_SPLIT_BLE_PREF_INT; until that takes effect (a few idle
      intervals), keys from the peripheral arrive at the idle interval.
      If the latency would not fit the supervision timeout at this interval,
      the latency is lowered. 0 keeps CONFIG_ZMK_SPLIT_BLE_PREF_INT always.

config ZMK_SPLIT_BLE_IDLE_LATENCY
    int "Peripheral latency for the split connection while the keyboard is idle"
    depends on ZMK_SPLIT_BLE_IDLE_INT > 0
    default ZMK_SPLIT_BLE_PREF_LATENCY
    help
      Connection events the peripheral may sleep through at the idle interval.
      A long sleep before the switch back to the fast interval can lose the
      link (seen with the Zephyr controller at 60 ms and latency 30: the link
      dropped right after most switches back). A small value keeps the
      peripheral listening often enough while still saving the central's power,
      which does not depend on the latency.

      Switching back from the idle interval has dropped the split link about
      a second later with Zephyr's controller in ZMK's Zephyr v4.1.0
      (zmkfirmware/zephyr v4.1.0+zmk-fixes): it does not restart the
      supervision countdown at the connection update instant. The fix is on
      rleyvasal/zephyr v4.1.0+zmk-fixes+supervision-reset (ae038c05); use it
      until it is upstream.

endif # ZMK_SPLIT_ROLE_CENTRAL

if !ZMK_SPLIT_ROLE_CENTRAL

config ZMK_SPLIT_BLE_PERIPHERAL_STACK_SIZE
    int "BLE split peripheral notify thread stack size"
    default 756

config ZMK_SPLIT_BLE_PERIPHERAL_PRIORITY
    int "BLE split peripheral notify thread priority"
    default 5

config ZMK_SPLIT_BLE_PERIPHERAL_POSITION_QUEUE_SIZE
    int "Max number of key position state events to queue to send to the central"
    default 10

config BT_MAX_PAIRED
    default 1

config BT_MAX_CONN
    default 1

# Allow central to specify connection parameters.
config BT_GAP_AUTO_UPDATE_CONN_PARAMS
    default n

endif # !ZMK_SPLIT_ROLE_CENTRAL

if ZMK_INPUT_SPLIT

config ZMK_INPUT_SPLIT_MSG_QUEUE_SIZE
    int "Max number of input split messages to queue for sending over BLE"
    default 32
    help
      Sets the maximum number of input split events that can be queued for BLE notifications.
      Increasing this reduces drops during high-rate input bursts at the cost of additional RAM.

endif # ZMK_INPUT_SPLIT

endmenu

endif # ZMK_SPLIT_BLE
